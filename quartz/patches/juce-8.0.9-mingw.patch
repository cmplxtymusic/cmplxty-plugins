@@ -168,7 +168,23 @@ std::unique_ptr<ScopedMessageBoxInterface> ScopedMessageBoxInterface::create (co
                 config.cButtons = (UINT) buttonLabels.size();
 
                 int buttonIndex = 0;
-                TaskDialogIndirect (&config, &buttonIndex, nullptr, nullptr);
+                // Quartz patch: TaskDialogIndirect only exists in comctl32 v6 (needs an activation manifest in the host process).
+                // Resolve it at run time so the plug-in loads in hosts without that manifest, and fall back to MessageBoxW.
+                using TaskDialogIndirectFn = HRESULT (WINAPI*) (const TASKDIALOGCONFIG*, int*, int*, BOOL*);
+                TaskDialogIndirectFn taskDialogFn = nullptr;
+                if (auto comctl = LoadLibraryW (L"comctl32.dll"))
+                    taskDialogFn = (TaskDialogIndirectFn) (void*) GetProcAddress (comctl, "TaskDialogIndirect");
+
+                if (taskDialogFn == nullptr || FAILED (taskDialogFn (&config, &buttonIndex, nullptr, nullptr)))
+                {
+                    UINT type = MB_TOPMOST;
+                    type |= buttonLabels.size() >= 3 ? MB_YESNOCANCEL : buttonLabels.size() == 2 ? MB_YESNO : MB_OK;
+                    if (options.getIconType() == MessageBoxIconType::WarningIcon) type |= MB_ICONWARNING;
+                    else if (options.getIconType() == MessageBoxIconType::InfoIcon) type |= MB_ICONINFORMATION;
+                    else if (options.getIconType() == MessageBoxIconType::QuestionIcon) type |= MB_ICONQUESTION;
+                    const auto r = MessageBoxW (parent, message.toWideCharPointer(), title.toWideCharPointer(), type);
+                    buttonIndex = (r == IDYES || r == IDOK) ? 0 : r == IDNO ? 1 : (buttonLabels.size() >= 3 ? 2 : 0);
+                }
 
                 return buttonIndex;
             };

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(TC_ROOT $ENV{LLVM_MINGW_ROOT})
set(CMAKE_C_COMPILER   ${TC_ROOT}/bin/x86_64-w64-mingw32-clang)
set(CMAKE_CXX_COMPILER ${TC_ROOT}/bin/x86_64-w64-mingw32-clang++)
set(CMAKE_RC_COMPILER  ${TC_ROOT}/bin/x86_64-w64-mingw32-windres)
set(CMAKE_AR ${TC_ROOT}/bin/llvm-ar)
set(CMAKE_RANLIB ${TC_ROOT}/bin/llvm-ranlib)
set(CMAKE_FIND_ROOT_PATH ${TC_ROOT}/x86_64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
# d2d1/d3d11/dxgi/dcomp are only used by JUCE's optional Direct2D renderer (GDI is the default): delay-load them so the plug-in loads even if absent.
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static -Wl,--delayload=d2d1.dll -Wl,--delayload=d3d11.dll -Wl,--delayload=dxgi.dll -Wl,--delayload=dcomp.dll")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-static -Wl,--delayload=d2d1.dll -Wl,--delayload=d3d11.dll -Wl,--delayload=dxgi.dll -Wl,--delayload=dcomp.dll")
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE NEVER)
get_filename_component(_QCOMPAT "${CMAKE_CURRENT_LIST_DIR}/compat" ABSOLUTE)
set(CMAKE_CXX_FLAGS_INIT "-isystem ${_QCOMPAT} -include ${_QCOMPAT}/quartz_mingw_compat.h -Wno-error")
set(CMAKE_C_FLAGS_INIT "-isystem ${_QCOMPAT}")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-lshlwapi -lversion -lws2_32 -lwinmm -lwininet -ldelayimp -lcomdlg32 -lole32 -loleaut32 -luuid -limm32 -ldbghelp -lgdi32 -lshell32 -ladvapi32 -luser32 -lkernel32 -lrpcrt4 -ldxgi -ld3d11 -ld2d1 -ldwrite -luiautomationcore -lsetupapi -lwsock32 -lopengl32 -ldwmapi -ldcomp")
set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_CXX_STANDARD_LIBRARIES_INIT}")
